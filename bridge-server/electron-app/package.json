{
  "name": "dante-audio-client",
  "version": "1.3.13",
  "description": "Dante Audio Client - Stream audio to Railway",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/soundrolling/electrondante.git"
  },
  "scripts": {
    "start": "electron . --max-old-space-size=4096",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w naudiodon",
    "version:increment": "node increment-version.js",
    "build": "npm run version:increment && electron-builder",
    "prebuild:mac": "node prepare-entitlements.js",
    "build:mac": "npm run version:increment && electron-builder --mac --publish=never",
    "build:local": "npm run version:increment && electron-builder --mac --dir --publish=never",
    "build:simple": "npm run version:increment && SKIP_NATIVE_REBUILD=true electron-builder --mac --dir --publish=never",
    "build:win": "npm run version:increment && electron-builder --win",
    "build:linux": "npm run version:increment && electron-builder --linux",
    "dist": "npm run version:increment && npm run rebuild && electron-builder"
  },
  "build": {
    "appId": "com.soundrolling.dante-audio-client",
    "productName": "Dante Audio Client",
    "artifactName": "${productName}-${version}.${ext}",
    "afterPack": "custom-sign.js",
    "afterSign": "notarize.js",
    "npmRebuild": false,
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "client-core.js",
      "opus-encoder.js",
      "opus-decoder.js",
      "config/**/*",
      "services/**/*",
      "utils/**/*",
      "index.html",
      "admin.html",
      "admin.js",
      "package.json",
      "!node_modules/**/*",
      "node_modules/ws/**/*",
      "node_modules/@supabase/**/*",
      "node_modules/express/**/*",
      "node_modules/naudiodon/**/*",
      "node_modules/opusscript/**/*",
      "node_modules/bindings/**/*",
      "node_modules/segfault-handler/**/*",
      "node_modules/file-uri-to-path/**/*",
      "node_modules/update-electron-app/**/*",
      "!node_modules/naudiodon/{test,examples,*.md,*.ts}",
      "!**/*.{md,ts,map}",
      "!**/*.{spec,test}.js",
      "!**/README*",
      "!**/CHANGELOG*"
    ],
    "asarUnpack": [
      "node_modules/naudiodon/build/Release/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "type": "distribution",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": null,
      "notarize": {
        "teamId": "${APPLE_TEAM_ID}"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": null
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "file-uri-to-path": "^1.0.0",
    "naudiodon": "^2.3.4",
    "opusscript": "^0.0.8",
    "segfault-handler": "^1.3.0",
    "update-electron-app": "^2.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@electron/notarize": "^2.3.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9"
  }
}
